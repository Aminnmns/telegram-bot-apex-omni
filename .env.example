# Kopieer dit bestand naar ".env" en vul in. Zet .env NOOIT in git/publiek.

# --- Telegram API credentials ---
# Aanmaken op https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=signal_bot_session
# Groep username (zonder @), invite-link, of numerieke chat-ID
TELEGRAM_GROUP=
# Waar de bot JOU updates over uitgevoerde trades stuurt. "me" = Saved Messages
TELEGRAM_NOTIFY_CHAT=me

# --- Hyperliquid ---
# Zelfde seed phrase als je Phantom Solana-wallet, apart 0x-adres. Exporteren
# via Phantom: instellingen -> account -> Show Private Key -> netwerk
# "Ethereum" kiezen (Ethereum/Base/Polygon/HyperEVM delen dezelfde private key).
HYPERLIQUID_PRIVATE_KEY=
# Optioneel, leeg = adres dat bij HYPERLIQUID_PRIVATE_KEY hoort.
HYPERLIQUID_ACCOUNT_ADDRESS=
# "mainnet" of "testnet"
HYPERLIQUID_ENV=mainnet

# --- Mode ---
# Laat op True staan totdat je alles hebt getest!
DRY_RUN=True

# Max. gelijktijdig open live posities, gecheckt via Hyperliquid's eigen
# clearinghouseState vlak voor elke nieuwe entry.
MAX_CONCURRENT_POSITIONS=8

# --- Positiegrootte ---
# Elke trade gebruikt dit percentage van je op dat moment beschikbare saldo
# als margin (isolated -- dit is dus ook je worst-case-verlies per trade).
MAX_MARGIN_PCT_OF_FUNDS=33.0

# Hyperliquid's eigen minimum-orderwaarde.
MIN_NOTIONAL_USD=10.0

# --- v2 TP-executie (voor NIEUWE signals, via groep-TP-berichten) ---
# 5-staps ladder, % van de ORIGINELE qty per target-bericht. Target 5 heeft
# geen eigen %: die sluit altijd de volledige rest (finale exit).
TP_EVENT_TARGET1_CLOSE_PCT=40
TP_EVENT_TARGET2_CLOSE_PCT=20
TP_EVENT_TARGET3_CLOSE_PCT=15
TP_EVENT_TARGET4_CLOSE_PCT=15

# Bij welke target (1-4) de SL naar break-even verplaatst. Later dan target 1
# geeft de trade meer ademruimte voordat de tight break-even-stop actief
# wordt, zodat een normale terugval na een vroege TP1 niet meteen de hele
# rest van de positie sluit voordat latere targets geraakt worden.
BREAKEVEN_MOVE_AFTER_TARGET=2
# De break-even-SL wordt dynamisch berekend uit de ECHT gebankte winst van
# eerdere targets (zodat de trade als geheel nooit netto verlies maakt) --
# dit is alleen nog een kleine veiligheidsmarge (% van de resterende
# notional) voor fees/slippage, afgetrokken vóór die berekening.
BREAKEVEN_PNL_SAFETY_MARGIN_PCT=0.1
